# Copy to .env and fill in. Never commit .env.
# NoTokenLimit API key (server-side only; never sent to the browser).
NTL_API_KEY=your-notokenlimit-api-key-here
# Model ID permitted for your account (see Settings -> Model, or GET /api/v1/models).
NTL_MODEL=
NTL_BASE_URL=https://notokenlimit.com/api/v1
NTL_TIMEOUT_MS=120000
NTL_MAX_RETRIES=2

# Optional: other model providers, usable next to NoTokenLimit (server-side only). Set the ones you
# use; their models appear in Settings -> Model ("anthropic:…", "openai:…", "openrouter:…", "gemini:…",
# "7api:…").
# Timeout and retries above apply to them too. The base URLs below are the defaults: change one only
# to go through a proxy or a compatible gateway (https, or http for localhost only).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Google Gemini (https://aistudio.google.com/apikey), through its OpenAI-compatible API.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# 7API (https://7api.st), a pay-per-token gateway to Claude, GPT, Gemini, Grok, DeepSeek, GLM, Kimi, ...
SEVENAPI_API_KEY=
SEVENAPI_BASE_URL=https://7api.st/v1

# Optional: Tavily API key for web search and deep research (server-side only; https://tavily.com).
# Reading web pages works without it.
TAVILY_API_KEY=

# Local server
FRIDAY_PORT=4317
# Vite dev server port for `npm run dev` (the API allows this origin)
FRIDAY_WEB_PORT=5173
# Where SQLite data lives (default: ./.data in the repo root)
FRIDAY_DATA_DIR=
# Set to 1 to run the live NoTokenLimit integration test (consumes a little quota)
NTL_INTEGRATION=0
