{
  "name": "friday",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first AI coding and DevOps assistant powered by NoTokenLimit",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web",
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @friday/web && npm run build -w @friday/server && npm run build -w @friday/desktop",
    "start": "npm run start -w @friday/server",
    "desktop": "npm run build && npm run start -w @friday/desktop",
    "dist:desktop": "npm run build -w @friday/web && npm run dist -w @friday/desktop",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @friday/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
